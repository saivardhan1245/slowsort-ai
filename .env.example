# SlowSort AI Configuration
# Real local filesystem organization with Gemini AI suggestions

# GEMINI_API_KEY: Google Gemini API Key for intelligent organization suggestions (backend only)
GEMINI_API_KEY=your_api_key

# GEMINI_MODEL: Supported Gemini model identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ALLOWED_ROOT: Base boundary directory for local filesystem safety enforcement
ALLOWED_ROOT=your_local_directory

# PORT: Local web server port (default: 3000)
PORT=3000
